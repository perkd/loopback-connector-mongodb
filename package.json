{
  "name": "@perkd/loopback-connector-mongodb",
  "version": "7.1.0",
  "description": "The official MongoDB connector for the LoopBack framework.",
  "engines": {
    "node": ">=24"
  },
  "author": "IBM Corp.",
  "main": "index.js",
  "scripts": {
    "benchmarks": "make benchmarks",
    "leak-detection": "make leak-detection",
    "test": "yarn test:unit && yarn test:juggler && yarn test:juggler:v5",
    "test:unit": "c8 node --test --test-force-exit --test-concurrency=2 --test-reporter=spec --test-timeout=5000 tests/connector-functions.test.js tests/decimal.test.js tests/findorcreate-objectid.unit.test.js tests/id.test.js tests/method-options.test.js tests/mongodb.test.js tests/multitenant.test.js tests/objectid.test.js",
    "test:multitenant": "node --test --test-force-exit --test-reporter=spec --test-timeout=5000 tests/multitenant-dispatch.test.js",
    "test:transactions": "TEST_TRANSACTIONS=1 node --test --test-force-exit --test-reporter=spec --test-timeout=10000 tests/transaction.test.js",
    "test:juggler": "mocha --exit --timeout=10000 node_modules/juggler-v4/test.js",
    "test:juggler:v5": "mocha --exit --timeout=10000 node_modules/juggler-v5/test.js",
    "coverage:text": "c8 report --reporter=text",
    "coverage:lcov": "c8 report --reporter=lcov",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "posttest": "yarn lint",
    "reinstall": "(rm -rf node_modules/ || true) && (rm yarn.lock || true) && yarn install",
    "release": "perkd-release release",
    "release:publish": "perkd-release publish"
  },
  "files": [
    "intl",
    "lib",
    "docs.json",
    "index.js",
    "setup.sh"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/perkd/loopback-connector-mongodb.git"
  },
  "keywords": [
    "connector",
    "datasource",
    "loopback",
    "mongodb"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/perkd/loopback-connector-mongodb/issues"
  },
  "homepage": "https://github.com/perkd/loopback-connector-mongodb#readme",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "dependencies": {
    "debug": "^4.4.3",
    "loopback-connector": "5.3.3",
    "mongodb": "^7.5.0",
    "strong-globalize": "^6.0.6"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/eslintrc": "^3.3.6",
    "@perkd/multitenant-context": "^0.8.4",
    "@perkd/release": "0.1.6",
    "benchmark": "^2.1.4",
    "c8": "^12.0.0",
    "commitlint": "^21.2.2",
    "eslint": "^10.8.1",
    "eslint-config-loopback": "^14.0.0",
    "globals": "^17.11.0",
    "juggler-v4": "file:./deps/juggler-v4",
    "juggler-v5": "file:./deps/juggler-v5",
    "loopback-datasource-juggler": "npm:@perkd/loopback-datasource-juggler@^6.1.1",
    "mocha": "^11.8.0",
    "rc": "^1.2.8",
    "semver": "^7.8.5"
  },
  "resolutions": {
    "minimatch": "^9.0.7",
    "glob": "^10.5.0",
    "eslint-plugin-mocha": "^11.3.0"
  },
  "packageManager": "yarn@4.18.0",
  "perkdRelease": {
    "test": {
      "command": "yarn test:unit"
    }
  }
}
